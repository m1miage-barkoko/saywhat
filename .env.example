# Copy this file to `.env` (same folder) and fill it in.

# Hugging Face token (read only). Needed ONLY to download the pyannote diarization
# model once; Verbatim then works offline. See README, "Hugging Face token".
HF_TOKEN=

# Default transcription model:
#   bofenghuang/whisper-large-v3-french  (default, best accuracy)
#   large-v3 | large-v3-turbo | eustlb/distil-large-v3-fr
# VERBATIM_WHISPER_MODEL=bofenghuang/whisper-large-v3-french

# Data folder (recordings, transcripts, models). Default: ./data
# Do not put it in a synced folder (iCloud, Dropbox…).
# VERBATIM_DATA_DIR=

# Hardware: auto | cuda | mps | cpu
# VERBATIM_DEVICE=auto

# Fine tuning (empty = a value suited to the detected hardware)
# VERBATIM_BATCH_SIZE=
# VERBATIM_CPU_THREADS=
# Noise reduction attenuation limit in dB (empty = maximum). E.g. 20 = more natural.
# VERBATIM_DENOISE_ATTEN_LIM_DB=
