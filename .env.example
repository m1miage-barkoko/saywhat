# Copiez ce fichier en `.env` (même dossier) et complétez-le.

# Jeton Hugging Face (lecture seule). Nécessaire UNIQUEMENT pour télécharger
# une fois le modèle de diarisation pyannote ; ensuite Verbatim fonctionne hors ligne.
# Voir README, section « Jeton Hugging Face ».
HF_TOKEN=

# Modèle de transcription par défaut :
#   bofenghuang/whisper-large-v3-french  (défaut, meilleure précision)
#   large-v3 | large-v3-turbo | eustlb/distil-large-v3-fr
# VERBATIM_WHISPER_MODEL=bofenghuang/whisper-large-v3-french

# Dossier des données (enregistrements, transcriptions, modèles convertis).
# Par défaut : ./data. Ne le placez pas dans un dossier synchronisé (iCloud, Dropbox…).
# VERBATIM_DATA_DIR=

# Matériel : auto | cuda | mps | cpu
# VERBATIM_DEVICE=auto

# Réglages fins (laisser vide = valeur adaptée au matériel détecté)
# VERBATIM_BATCH_SIZE=
# VERBATIM_CPU_THREADS=
# Limite d'atténuation du débruitage en dB (vide = maximale). Ex. 20 = plus naturel.
# VERBATIM_DENOISE_ATTEN_LIM_DB=
